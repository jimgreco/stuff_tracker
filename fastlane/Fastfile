ENV["FASTLANE_SKIP_UPDATE_CHECK"] = "1"

default_platform(:ios)
opt_out_usage

APP_IDENTIFIER = "com.jimgreco.stufftracker"
APP_TARGET = "StuffTracker"
PROJECT_PATH = "ios/StuffTracker.xcodeproj"
APP_VERSION_CONFIGURATION = "Release"
SCREENSHOT_SCHEME = "StuffTrackerScreenshots"
SCREENSHOT_OUTPUT = "fastlane/screenshots"
SCREENSHOT_FRAME_SCRIPT = File.expand_path("scripts/frame_screenshots.swift", __dir__)
SCREENSHOT_OUTPUT_PATH = File.expand_path("../#{SCREENSHOT_OUTPUT}", __dir__)
EXPECTED_SCREENSHOT_IDS = [
  "01-Home-Hierarchy",
  "02-Flagged-Items",
  "03-Search",
  "04-Item-Details"
].freeze

def screenshot_devices
  raw_devices = ENV["SCREENSHOT_DEVICES"] || "iPhone 17 Pro Max,iPad Pro 13-inch (M5)"
  raw_devices.split(",").map(&:strip).reject(&:empty?)
end

def relative_screenshot_paths(paths)
  paths.map { |path| path.sub(%r{\A#{Regexp.escape(SCREENSHOT_OUTPUT)}/?}, '') }.sort
end

platform :ios do
  desc "Capture App Store screenshots from deterministic local sample data"
  lane :screenshots do
    capture_ios_screenshots(
      project: PROJECT_PATH,
      scheme: SCREENSHOT_SCHEME,
      app_identifier: APP_IDENTIFIER,
      configuration: "Debug",
      devices: screenshot_devices,
      languages: ["en-US"],
      output_directory: SCREENSHOT_OUTPUT,
      clear_previous_screenshots: true,
      reinstall_app: true,
      clean: true,
      override_status_bar: true,
      skip_open_summary: true
    )
    sh("xcrun", "swift", SCREENSHOT_FRAME_SCRIPT, SCREENSHOT_OUTPUT_PATH)
  end

  desc "Upload generated screenshots to the current Xcode marketing version in App Store Connect"
  lane :upload_screenshots do
    validate_screenshot_upload_set
    upload_to_app_store(
      api_key: app_store_api_key,
      app_identifier: APP_IDENTIFIER,
      app_version: app_store_version,
      screenshots_path: SCREENSHOT_OUTPUT_PATH,
      skip_binary_upload: true,
      skip_metadata: true,
      overwrite_screenshots: true,
      force: true,
      run_precheck_before_submit: false,
      submit_for_review: false
    )
  end

  desc "Capture screenshots, then upload them to App Store Connect"
  lane :screenshots_and_upload do
    screenshots
    upload_screenshots
  end

  private_lane :app_store_version do
    version_override = ENV["APP_STORE_VERSION"].to_s.strip
    if version_override.empty?
      get_version_number(
        xcodeproj: PROJECT_PATH,
        target: APP_TARGET,
        configuration: APP_VERSION_CONFIGURATION
      )
    else
      version_override
    end
  end

  private_lane :validate_screenshot_upload_set do
    uploadable_screenshots = Dir.glob(File.join(SCREENSHOT_OUTPUT_PATH, "**", "*.{jpg,jpeg,png}"))
    screenshots_by_device = Hash.new { |screenshots, device| screenshots[device] = [] }
    unexpected_screenshots = []

    uploadable_screenshots.each do |path|
      basename = File.basename(path, File.extname(path))
      match = basename.match(/\A(.+?)-(\d{2}-.+)\z/)
      if match
        screenshots_by_device[match[1]] << match[2]
      else
        unexpected_screenshots << path
      end
    end

    errors = []
    errors << "unexpected files: #{relative_screenshot_paths(unexpected_screenshots).join(', ')}" if unexpected_screenshots.any?
    errors << "no framed screenshots found" if screenshots_by_device.empty?

    screenshots_by_device.each do |device, screenshot_ids|
      next if screenshot_ids.sort == EXPECTED_SCREENSHOT_IDS

      errors << "#{device} has #{screenshot_ids.length} screenshots: #{screenshot_ids.sort.join(', ')}"
    end

    UI.user_error!("Invalid screenshot upload set: #{errors.join('; ')}") if errors.any?
  end

  private_lane :app_store_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
      is_key_content_base64: false,
      duration: 1200,
      in_house: false
    )
  end
end
