ENV["FASTLANE_SKIP_UPDATE_CHECK"] = "1"

require "deliver/app_screenshot"
require "spaceship"

default_platform(:ios)
opt_out_usage

APP_IDENTIFIER = "com.jimgreco.stufftracker"
APP_TARGET = "StuffTracker"
PROJECT_PATH = "ios/StuffTracker.xcodeproj"
APP_VERSION_CONFIGURATION = "Release"
SCREENSHOT_SCHEME = "StuffTrackerScreenshots"
SCREENSHOT_OUTPUT = "fastlane/screenshots"
SCREENSHOT_FRAME_SCRIPT = File.expand_path("scripts/frame_screenshots.swift", __dir__)
SCREENSHOT_OUTPUT_PATH = File.expand_path("../#{SCREENSHOT_OUTPUT}", __dir__)
EXPECTED_SCREENSHOT_IDS = [
  "01-Home-Hierarchy",
  "02-Flagged-Items",
  "03-Search",
  "04-Item-Details"
].freeze
TARGET_SCREENSHOT_DISPLAY_TYPES = [
  Spaceship::ConnectAPI::AppScreenshotSet::DisplayType::APP_IPHONE_67,
  Spaceship::ConnectAPI::AppScreenshotSet::DisplayType::APP_IPAD_PRO_3GEN_129
].freeze

def screenshot_devices
  raw_devices = ENV["SCREENSHOT_DEVICES"] || "iPhone 17 Pro Max,iPad Pro 13-inch (M5)"
  raw_devices.split(",").map(&:strip).reject(&:empty?)
end

def relative_screenshot_paths(paths)
  paths.map { |path| path.sub(%r{\A#{Regexp.escape(SCREENSHOT_OUTPUT)}/?}, '') }.sort
end

def uploadable_screenshot_paths
  Dir.glob(File.join(SCREENSHOT_OUTPUT_PATH, "**", "*.{jpg,jpeg,png}")).sort
end

def screenshot_id(path)
  basename = File.basename(path, File.extname(path))
  match = basename.match(/\A(.+?)-(\d{2}-.+)\z/)
  match && match[2]
end

def app_store_screenshots
  uploadable_screenshot_paths.map do |path|
    {
      path: path,
      language: File.basename(File.dirname(path)),
      display_type: Deliver::AppScreenshot.calculate_display_type(path),
      screenshot_id: screenshot_id(path)
    }
  end
end

def app_store_version_for_upload(expected_version)
  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
  UI.user_error!("Could not find App Store Connect app '#{APP_IDENTIFIER}'") unless app

  version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
  UI.user_error!("Could not find an editable App Store Connect version for '#{APP_IDENTIFIER}'") unless version

  if version.version_string != expected_version
    UI.user_error!("Editable App Store Connect version is '#{version.version_string}', expected '#{expected_version}'")
  end

  version
end

def app_store_localization(version, language)
  localization = version.get_app_store_version_localizations.find { |candidate| candidate.locale == language }
  localization ||= version.create_app_store_version_localization(attributes: { locale: language })
  localization
end

def replace_app_store_screenshot_set(localization, display_type, screenshots)
  existing_sets = localization.get_app_screenshot_sets.select do |set|
    set.screenshot_display_type == display_type
  end
  existing_sets.each do |set|
    set.delete!
    UI.message("Deleted '#{localization.locale} #{set.screenshot_display_type}'")
  end

  screenshot_set = localization.create_app_screenshot_set(
    attributes: { screenshotDisplayType: display_type }
  )
  uploaded_ids = screenshots.sort_by { |screenshot| screenshot[:screenshot_id] }.map.with_index do |screenshot, index|
    UI.message("Uploading '#{screenshot[:path]}'")
    uploaded = screenshot_set.upload_screenshot(
      path: screenshot[:path],
      wait_for_processing: true,
      position: index
    )
    uploaded.id
  end
  screenshot_set.reorder_screenshots(app_screenshot_ids: uploaded_ids)
end

platform :ios do
  desc "Capture App Store screenshots from deterministic local sample data"
  lane :screenshots do
    capture_ios_screenshots(
      project: PROJECT_PATH,
      scheme: SCREENSHOT_SCHEME,
      app_identifier: APP_IDENTIFIER,
      configuration: "Debug",
      devices: screenshot_devices,
      languages: ["en-US"],
      output_directory: SCREENSHOT_OUTPUT,
      clear_previous_screenshots: true,
      reinstall_app: true,
      clean: true,
      override_status_bar: true,
      skip_open_summary: true
    )
    sh("xcrun", "swift", SCREENSHOT_FRAME_SCRIPT, SCREENSHOT_OUTPUT_PATH)
  end

  desc "Upload generated screenshots to the current Xcode marketing version in App Store Connect"
  lane :upload_screenshots do
    validate_screenshot_upload_set
    app_store_api_key
    version = app_store_version_for_upload(app_store_version)
    app_store_screenshots.group_by { |screenshot| [screenshot[:language], screenshot[:display_type]] }.each do |(language, display_type), screenshots|
      localization = app_store_localization(version, language)
      replace_app_store_screenshot_set(localization, display_type, screenshots)
    end
    UI.success("Successfully uploaded screenshots to App Store Connect")
  end

  desc "Capture screenshots, then upload them to App Store Connect"
  lane :screenshots_and_upload do
    screenshots
    upload_screenshots
  end

  private_lane :app_store_version do
    version_override = ENV["APP_STORE_VERSION"].to_s.strip
    if version_override.empty?
      get_version_number(
        xcodeproj: PROJECT_PATH,
        target: APP_TARGET,
        configuration: APP_VERSION_CONFIGURATION
      )
    else
      version_override
    end
  end

  private_lane :validate_screenshot_upload_set do
    screenshots_by_device = Hash.new { |screenshots, device| screenshots[device] = [] }
    screenshots_by_display_type = Hash.new { |screenshots, display_type| screenshots[display_type] = [] }
    unexpected_screenshots = []

    uploadable_screenshot_paths.each do |path|
      basename = File.basename(path, File.extname(path))
      match = basename.match(/\A(.+?)-(\d{2}-.+)\z/)
      if match
        screenshots_by_device[match[1]] << match[2]
        display_type = Deliver::AppScreenshot.calculate_display_type(path)
        screenshots_by_display_type[display_type] << path
      else
        unexpected_screenshots << path
      end
    end

    errors = []
    errors << "unexpected files: #{relative_screenshot_paths(unexpected_screenshots).join(', ')}" if unexpected_screenshots.any?
    errors << "no framed screenshots found" if screenshots_by_device.empty?
    unexpected_display_types = screenshots_by_display_type.keys - TARGET_SCREENSHOT_DISPLAY_TYPES
    errors << "unexpected display types: #{unexpected_display_types.map(&:to_s).sort.join(', ')}" if unexpected_display_types.any?

    screenshots_by_device.each do |device, screenshot_ids|
      next if screenshot_ids.sort == EXPECTED_SCREENSHOT_IDS

      errors << "#{device} has #{screenshot_ids.length} screenshots: #{screenshot_ids.sort.join(', ')}"
    end

    TARGET_SCREENSHOT_DISPLAY_TYPES.each do |display_type|
      screenshot_count = screenshots_by_display_type[display_type].length
      next if screenshot_count == EXPECTED_SCREENSHOT_IDS.length

      errors << "#{display_type} has #{screenshot_count} screenshots"
    end

    UI.user_error!("Invalid screenshot upload set: #{errors.join('; ')}") if errors.any?
  end

  private_lane :app_store_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
      is_key_content_base64: false,
      duration: 1200,
      in_house: false
    )
  end
end
